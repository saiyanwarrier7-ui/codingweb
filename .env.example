# Port for Express server and Vite development
PORT=3000

# Secret key for JWT session tokens and password encryption
JWT_SECRET="codearena-jwt-secret-key-change-in-production"

# Optional: Judge0 API credentials (if preferred over default Wandbox/Local execution engine)
# JUDGE0_API_KEY=""
# JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# Optional: Supabase credentials (if connecting directly to remote Supabase project)
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Studio injected environment variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
